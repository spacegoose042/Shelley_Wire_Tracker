generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String
  name                 String?
  role                 Role                  @default(TECHNICIAN)
  createdAt            DateTime              @default(now())
  transactions         Transaction[]
  receipts             InventoryReceipt[]
  receiptJobWorkOrders ReceiptJobWorkOrder[]
}

enum Role {
  ADMIN
  TECHNICIAN
}

model Part {
  id              String             @id @default(cuid())
  partNumber      String
  description     String?
  location        String             @default("")
  unit            Unit               @default(FEET)
  currentQuantity Decimal            @default(0) @db.Decimal(12, 2)
  archived        Boolean            @default(false)
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lines           TransactionLine[]
  receipts        InventoryReceipt[]

  @@unique([partNumber, location])
}

model InventoryReceipt {
  id            String                @id @default(cuid())
  partId        String
  part          Part                  @relation(fields: [partId], references: [id], onDelete: Cascade)
  quantity      Decimal               @db.Decimal(12, 2)
  notes         String?
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  jobWorkOrders ReceiptJobWorkOrder[]
}

model ReceiptJobWorkOrder {
  id            String           @id @default(cuid())
  receiptId     String
  receipt       InventoryReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  number        String
  addedByUserId String?
  addedBy       User?            @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@unique([receiptId, number])
  @@index([number])
}

enum Unit {
  FEET
  EACH
}

model Transaction {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobName   String
  processed Boolean           @default(false)
  createdAt DateTime          @default(now())
  lines     TransactionLine[]
}

model TransactionLine {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  partId        String
  part          Part        @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity      Decimal     @db.Decimal(12, 2)
}
